rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the host of a room
    function isHost(roomData) {
      return isAuthenticated() && 
             request.auth.uid == roomData.hostUid;
    }
    
    // Rooms collection
    match /rooms/{roomId} {
      // Allow authenticated users to read rooms
      allow read: if isAuthenticated();
      
      // Allow authenticated users to create rooms
      // Must set hostUid to their own UID and include themselves in players array
      allow create: if isAuthenticated() && 
                       request.resource.data.hostUid == request.auth.uid &&
                       request.auth.uid in request.resource.data.get('players', []);
      
      // Allow updates if:
      // 1. User is the host (can update anything), OR
      // 2. User is a player in the room, OR
      // 3. User is joining (adding themselves to players array)
      allow update: if isAuthenticated() && (
        // Host can update anything
        isHost(resource.data) ||
        // Existing players can update
        request.auth.uid in resource.data.get('players', []) ||
        // Allow joining: user is adding themselves to players array
        (request.auth.uid in request.resource.data.get('players', []) &&
         !(request.auth.uid in resource.data.get('players', [])))
      );
      
      // Allow host to delete their room
      allow delete: if isHost(resource.data);
      
      // Played words subcollection
      match /playedWords/{wordId} {
        // Anyone authenticated can read played words
        allow read: if isAuthenticated();
        // Only Cloud Functions should write (handled via Cloud Functions)
        allow write: if false;
      }
      
      // Meta subcollection (usedWords, etc.)
      match /meta/{docId} {
        // Anyone authenticated can read meta
        allow read: if isAuthenticated();
        // Only Cloud Functions should write
        allow write: if false;
      }
    }
  }
}

