rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user can write to a friendship document
    function canWriteFriendship(userId, friendUid) {
      return isAuthenticated() &&
             (request.auth.uid == userId || request.auth.uid == friendUid);
    }

    // Helper function to check if user is the host of a room
    function isHost(roomData) {
      return isAuthenticated() &&
             request.auth.uid == roomData.hostUid;
    }

    // Rooms collection (Word Match - Server-Authoritative)
    match /rooms/{roomId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        (request.auth.uid in resource.data.players) ||
        (request.auth.uid == resource.data.hostUid)
      );
      // All writes (create/update/delete) are performed exclusively via Cloud Functions Admin SDK
      allow write: if false;

      match /playedWords/{wordId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.players
        );
        allow write: if false;
      }

      match /meta/{docId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.players
        );
        allow write: if false;
      }

      match /receipts/{receiptId} {
        allow read, write: if false;
      }
    }

    // Arena Rooms collection (Grammar Arena - Server-Authoritative)
    match /arena_rooms/{roomId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        (request.auth.uid == resource.data.hostId) ||
        (request.auth.uid == resource.data.guestId)
      );
      // All writes (create/update/delete) are performed exclusively via Cloud Functions Admin SDK
      allow write: if false;

      match /answers/{answerId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/arena_rooms/$(roomId)).data.hostId == request.auth.uid ||
          get(/databases/$(database)/documents/arena_rooms/$(roomId)).data.guestId == request.auth.uid
        );
        allow write: if false;
      }

      match /round_answers/{docId} {
        allow read, write: if false;
      }

      match /receipts/{receiptId} {
        allow read, write: if false;
      }
    }

    // User settings collection
    match /user_settings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // User stats collection
    match /user_stats/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      match /trap_words/{wordId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // User word match sets
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;

      match /word_match_sets/{setId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          resource.data.visibility == 'public' ||
          (resource.data.visibility == 'friendsOnly' &&
           exists(/databases/$(database)/documents/friendships/$(userId)/friends/$(request.auth.uid)))
        );

        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.entityId == setId
          && request.resource.data.remoteVersion == 1
          && request.resource.data.isTombstone is bool
          && request.resource.data.lastOperationId is string
          && request.resource.data.lastOperationId.size() > 0;

        allow update: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.entityId == resource.data.entityId
          && request.resource.data.remoteVersion == resource.data.remoteVersion + 1
          && request.resource.data.isTombstone is bool
          && (request.resource.data.isTombstone == false
              || (request.resource.data.deletedAt is string
                  && request.resource.data.deletedAt.size() > 0));

        allow delete: if false;
      }

      match /outbox_receipts/{receiptId} {
        allow read: if isAuthenticated()
          && request.auth.uid == userId
          && resource.data.ownerUid == request.auth.uid;

        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.ownerUid == request.auth.uid
          && receiptId == request.resource.data.operationId
          && request.resource.data.operationId is string
          && request.resource.data.operationId.size() > 0
          && request.resource.data.entityId is string
          && request.resource.data.entityId.size() > 0
          && request.resource.data.entityType is string
          && request.resource.data.entityType.size() > 0
          && request.resource.data.appliedRemoteVersion is int
          && request.resource.data.appliedRemoteVersion > 0;

        allow update: if false;
        allow delete: if false;
      }

      match /sets/{setId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;

        match /pairs/{pairId} {
          allow read, write: if isAuthenticated() && request.auth.uid == userId;
        }
      }

      match /invitations/{invitationId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        // Created/accepted/deleted only by the authoritative callable.
        allow write: if false;
      }

      match /blocks/{blockedUid} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        // A block changes relationships and is therefore callable-only.
        allow write: if false;
      }

      match /ugc_acceptance/{acceptanceId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if false;
      }

      // Device registrations are server-owned through authenticated callables.
      match /notification_tokens/{tokenId} {
        allow read, write: if false;
      }
    }

    // Shared Word Match sets
    match /shares/{shareId} {
      allow read: if resource.data.status == 'published' && resource.data.visibility == 'public';
      // Published content is validated, owned and removed by callables only.
      allow write: if false;
    }

    // Friend requests
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow write: if false;
    }

    // Friendships
    match /friendships/{userId} {
      match /friends/{friendUid} {
        allow read: if canWriteFriendship(userId, friendUid);
        allow write: if false;
      }
    }

    // Never expose evidence, reporter identities, review state or internal notes.
    match /moderation_reports/{reportId} { allow read, write: if false; }
    match /report_cooldowns/{cooldownId} { allow read, write: if false; }
    match /social_rate_limits/{limitId} { allow read, write: if false; }
    match /notification_deliveries/{deliveryId} { allow read, write: if false; }

    // Sprint 10C: educational content reports — written exclusively through
    // the submitEducationalContentReport Callable Function (Admin SDK).
    // Clients have no read or write access; UID, timestamp and status are
    // derived server-side and must never be spoofed by the client.
    match /educational_content_reports/{reportId} { allow read, write: if false; }
    match /educational_content_report_cooldowns/{cooldownId} { allow read, write: if false; }
  }
}
