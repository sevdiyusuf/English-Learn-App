    "items": [
        {
            "id": "cond2_mcq1",
            "engine": "mcq",
            "prompt": "If I ____ a lot of money, I ____ a private jet.",
            "translation_tr": "Eğer çok param olsaydı özel bir jet alırdım.",
            "options": [
                "had / would buy",
                "have / will buy",
                "had / will buy"
            ],
            "answer": "had / would buy",
            "hint": "This is an imaginary situation in the present.",
            "explain": "Type 2 Conditionals use: If + Past Simple, ... would + Verb.",
            "tags": [
                "structure"
            ]
        },
        {
            "id": "cond2_mcq2",
            "engine": "mcq",
            "prompt": "If I ____ you, I wouldn't go to that party.",
            "translation_tr": "Senin yerinde olsaydım o partiye gitmezdim.",
            "options": [
                "were",
                "am",
                "was"
            ],
            "answer": "were",
            "hint": "In Type 2, we usually use 'were' for all subjects (I/He/She/It).",
            "explain": "For advice and hypothetical situations, 'were' is preferred over 'was' with 'I'.",
            "tags": [
                "advice",
                "were_rule"
            ]
        },
        {
            "id": "cond2_mcq3",
            "engine": "mcq",
            "prompt": "If she ____ more time, she would learn Japanese.",
