                "had",
                "has",
                "would have"
            ],
            "answer": "had",
            "hint": "The 'if' clause needs the Past Simple form.",
            "explain": "We use the past tense in the 'if' clause to show the situation is unreal.",
            "tags": [
                "structure"
            ]
        },
        {
            "id": "cond2_mcq4",
